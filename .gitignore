# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Replace build folders 
build/bin/
node_modules/
frontend/dist/
binaries/*

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.local
.env.production
.env.development
.env.*.local

# Editor/IDE
.idea/
.vscode/
*.suo
*.ntvsca*
*.njsproj
*.sln
*.sw?
.agents/rules
.codereview_report

# Temporary Files
*.tmp
*.temp
temp/

# Log files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System files
.DS_Store
Thumbs.db

# Template icons
frontend/src/components/tests/assets/*

# Remove md5 files
*.md5

# Remove setting files
*.toml

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.pyc
